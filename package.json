{
  "name": "genai-inference-model-evaluation-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sam local start-api",
    "build": "pnpm --dir frontend build && sam build",
    "build:backend": "bash scripts/build.sh",
    "deploy:backend": "dotenv -- bash scripts/build.sh && dotenv -- bash scripts/deploy.sh",
    "start:webui": "pnpm --dir frontend dev",
    "deploy:webui": "pnpm --dir frontend deploy:webui",
    "test": "vitest run",
    "test:backend": "vitest run backend/",
    "test:handlers": "vitest run backend/src/handlers/",
    "test:usecases": "vitest run backend/src/useCases/",
    "test:services": "vitest run backend/src/services/",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-ecs": "^3.800.0",
    "@aws-sdk/client-lambda": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@trackit.io/di-container": "1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^24.12.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "fast-check": "^4.6.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.1",
    "yaml": "^2.8.2"
  }
}
